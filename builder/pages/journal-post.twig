{#
	One Journal entry, at /journal/{id}. The entry's photo gives this page its color,
	the same way a project's cover does.

	Two things claim this address: this page, and the Journal collection's URL
	setting (/journal). The page wins, so it renders the entry. The collection URL
	is still needed: it gives each entry its canonical link, its sitemap entry and its RSS link.
	`tcms builder:routes` flags the pair as a duplicate. That warning is expected here.
#}
{% extends 'layouts/default.twig' %}
{% import 'macros/photo.twig' as photo %}

{% set post = cms.collection.object('journal', params.id) %}

{% block seo %}{{ cms.seo.head(post, {collection: 'journal'}) }}{% endblock %}

{% block photo %}{{ photo.color(post.image) }}{% endblock %}

{% block content %}
	{# A draft or a mistyped address gets the 404 page, not an empty page. #}
	{% if post is empty or post.draft %}{{ cms.notFound() }}{% endif %}
	{% include 'partials/band.twig' with {
		title: post.title,
		intro: post.summary|striptags,
		facts: {'Published': post.date|date('F j, Y', false)}
	} %}

	<figure class="lead">
		{{ cms.render.image(post, {w: 1800, h: 1000, fit: 'crop'}, {collection: 'journal', property: 'image', loading: 'eager'}) }}
	</figure>

	<article class="sheet section grid" data-tracks="12" data-threshold="md" data-gap="lg">
		<div class="prose" data-span="7" data-start="6">{{ post.content|raw }}</div>
	</article>
{% endblock %}
